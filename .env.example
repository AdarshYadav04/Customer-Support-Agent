# ---- Required ----------------------------------------------------------
# Postgres. postgresql:// or postgresql+asyncpg:// both work.
# For managed/SSL databases append ?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/support

# Your running LiteLLM proxy (the app calls its OpenAI-compatible Responses API)
LITELLM_PROXY_URL=http://localhost:4000/v1
LITELLM_PROXY_KEY=sk-your-litellm-key

# ---- Optional ----------------------------------------------------------
# Model names exactly as configured on your LiteLLM proxy
AGENT_MODEL=gpt-4.1
GUARDRAIL_MODEL=gpt-4.1-mini

# Create tables on startup (dev). Or run: python -m app.db.seed
AUTO_CREATE_TABLES=true

STORE_NAME=ShopEase
RETURN_WINDOW_DAYS=30
LOG_LEVEL=INFO
# Leave empty to disable the X-API-Key check on /v1/chat
SERVICE_API_KEY=
